  <eClassifiers xsi:type="ecore:EClass" name="Compra">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="MontoValido CantidadValida PlazoValido CotizacionesValidas ReferenciaValida JustificacionSuficiente PartidaIdentificada MontoCompraDirecta UmbralCompetitivo CotizacionesComite ProveedorIdentificado ReferenciaContable"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="MontoValido" value="context Compra inv MontoValido: self.monto &gt;= 1 and self.monto &lt;= 250000"/>
      <details key="CantidadValida" value="context Compra inv CantidadValida: self.cantidad &gt;= 1 and self.cantidad &lt;= 10000"/>
      <details key="PlazoValido" value="context Compra inv PlazoValido: self.plazo &gt;= 1 and self.plazo &lt;= 180"/>
      <details key="CotizacionesValidas" value="context Compra inv CotizacionesValidas: self.cotizaciones &gt;= 0 and self.cotizaciones &lt;= 30"/>
      <details key="ReferenciaValida" value="context Compra inv ReferenciaValida: self.referencia.size() &gt;= 4"/>
      <details key="JustificacionSuficiente" value="context Compra::avalar() pre JustificacionSuficiente: self.justificacion.size() &gt;= 20"/>
      <details key="PartidaIdentificada" value="context Compra::certificar() pre PartidaIdentificada: self.partida.size() &gt;= 4"/>
      <details key="MontoCompraDirecta" value="context Compra::directa() pre MontoCompraDirecta: self.monto &lt; 10000 and self.cotizaciones &gt;= 1"/>
      <details key="UmbralCompetitivo" value="context Compra::competitiva() pre UmbralCompetitivo: self.monto &gt;= 10000 and self.cotizaciones &gt;= 3"/>
      <details key="CotizacionesComite" value="context Compra::adjudicar() pre CotizacionesComite: self.cotizaciones &gt;= 3"/>
      <details key="ProveedorIdentificado" value="context Compra::emitir() pre ProveedorIdentificado: self.proveedor.size() &gt;= 3"/>
      <details key="ReferenciaContable" value="context Compra::contabilizar() pre ReferenciaContable: self.referencia.size() &gt;= 6"/>
    </eAnnotations>
