{
  "id": "gestion-laboratorio",
  "nombre": "Gestión de laboratorio",
  "objetivo": "Administra equipos y tramita préstamos con existencias compartidas.",
  "entidad": "Prestamo",
  "plataforma": "HTML5 / JavaScript ES2022 / IndexedDB + File System Access API + SQL DDL",
  "presentacion": "bandeja",
  "arquitectura": {
    "patronUi": "Bandeja Maestro-Detalle (Master-Detail Inbox)",
    "disposicion": "Layout de dos columnas 50/50: captura y lista cronológica a la izquierda; ficha técnica, acciones por rol e historial a la derecha.",
    "contenedores": [
      "Cabecera con selector de rol de demostración (Estudiante, Responsable)",
      "Columna izquierda: Formulario de captura (Nueva solicitud) + Bandeja vertical de casos con badge de estado",
      "Columna derecha: Inspector maestro-detalle, disparadores de transición y línea de tiempo auditada",
      "Módulo integrado de Catálogo (Producto) y Kardex de Movimientos",
      "Gestión de datos y exportación"
    ],
    "adaptadorDatos": "IndexedDB y localStorage en el navegador. Copias JSON y exportación SQL.",
    "seguridad": "Simulación de roles en cliente para 2 actores y 3 validadores OCL compilados a ES2022"
  },
  "almacen": {
    "tipo": "IndexedDB + localStorage",
    "clave": "mda.casos.proyecto.example-laboratorio.gestion-laboratorio"
  },
  "esquemaSql": {
    "motor": "SQLite 3",
    "tablas": [
      {
        "nombre": "producto",
        "descripcion": "Tabla de catálogo CRUD para Producto",
        "columnas": [
          {
            "nombre": "id",
            "tipo": "VARCHAR(64)",
            "restricciones": "PRIMARY KEY NOT NULL"
          },
          {
            "nombre": "nombre",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "sku",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL UNIQUE"
          },
          {
            "nombre": "categoria",
            "tipo": "VARCHAR(64)",
            "restricciones": "NOT NULL CHECK (categoria IN ('equipos', 'consumibles', 'repuestos'))"
          },
          {
            "nombre": "stock",
            "tipo": "INTEGER",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "ubicacion",
            "tipo": "VARCHAR(300)",
            "restricciones": "NULL"
          },
          {
            "nombre": "reposicion",
            "tipo": "DATE",
            "restricciones": "NULL"
          },
          {
            "nombre": "activo",
            "tipo": "BOOLEAN",
            "restricciones": "NULL"
          }
        ],
        "checks": [
          "CONSTRAINT chk_stocknonegativo CHECK (stock >= 0)"
        ]
      },
      {
        "nombre": "prestamo",
        "descripcion": "Tabla principal de casos de proceso para Prestamo",
        "columnas": [
          {
            "nombre": "id",
            "tipo": "VARCHAR(64)",
            "restricciones": "PRIMARY KEY NOT NULL"
          },
          {
            "nombre": "estado_actual",
            "tipo": "VARCHAR(48)",
            "restricciones": "NOT NULL DEFAULT 'solicitado'"
          },
          {
            "nombre": "solicitante",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "equipo",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL REFERENCES producto(id)"
          },
          {
            "nombre": "cantidad",
            "tipo": "INTEGER",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "dias",
            "tipo": "INTEGER",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "motivo",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL"
          }
        ],
        "checks": [
          "CONSTRAINT chk_prestamo_estado CHECK (estado_actual IN ('solicitado', 'aprobado', 'entregado', 'devuelto', 'rechazado'))",
          "CONSTRAINT chk_cantidadvalida CHECK (cantidad >= 1 AND cantidad <= 5)",
          "CONSTRAINT chk_plazovalido CHECK (dias >= 1 AND dias <= 30)"
        ]
      },
      {
        "nombre": "prestamo_historial",
        "descripcion": "Bitácora inmutable de auditoría de transiciones por rol",
        "columnas": [
          {
            "nombre": "id_evento",
            "tipo": "INTEGER",
            "restricciones": "PRIMARY KEY AUTOINCREMENT"
          },
          {
            "nombre": "caso_id",
            "tipo": "VARCHAR(64)",
            "restricciones": "NOT NULL REFERENCES prestamo(id) ON DELETE CASCADE"
          },
          {
            "nombre": "accion",
            "tipo": "VARCHAR(120)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "rol_actor",
            "tipo": "VARCHAR(64)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "fecha_hora",
            "tipo": "TIMESTAMP",
            "restricciones": "NOT NULL DEFAULT CURRENT_TIMESTAMP"
          }
        ],
        "checks": []
      },
      {
        "nombre": "prestamo_movimientos_stock",
        "descripcion": "Kardex de entradas y salidas vinculadas entre Prestamo y Producto",
        "columnas": [
          {
            "nombre": "id_movimiento",
            "tipo": "INTEGER",
            "restricciones": "PRIMARY KEY AUTOINCREMENT"
          },
          {
            "nombre": "caso_id",
            "tipo": "VARCHAR(64)",
            "restricciones": "NOT NULL REFERENCES prestamo(id)"
          },
          {
            "nombre": "producto_sku",
            "tipo": "VARCHAR(120)",
            "restricciones": "NOT NULL REFERENCES producto(sku)"
          },
          {
            "nombre": "transicion",
            "tipo": "VARCHAR(64)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "unidades",
            "tipo": "INTEGER",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "saldo_resultante",
            "tipo": "INTEGER",
            "restricciones": "NOT NULL CHECK (saldo_resultante >= 0)"
          },
          {
            "nombre": "fecha_hora",
            "tipo": "TIMESTAMP",
            "restricciones": "NOT NULL DEFAULT CURRENT_TIMESTAMP"
          }
        ],
        "checks": []
      }
    ]
  },
  "roles": [
    {
      "id": "estudiante",
      "nombre": "Estudiante"
    },
    {
      "id": "responsable",
      "nombre": "Responsable"
    }
  ],
  "campos": [
    {
      "id": "solicitante",
      "nombre": "Solicitante",
      "control": "text",
      "tipoSql": "VARCHAR(300)",
      "requerido": true,
      "atributosHtml": [
        "required",
        "maxlength=\"300\""
      ]
    },
    {
      "id": "equipo",
      "nombre": "Equipo del inventario",
      "control": "select",
      "tipoSql": "VARCHAR(300)",
      "requerido": true,
      "atributosHtml": [
        "required"
      ]
    },
    {
      "id": "cantidad",
      "nombre": "Cantidad",
      "control": "number",
      "tipoSql": "INTEGER",
      "requerido": true,
      "atributosHtml": [
        "required",
        "step=\"1\"",
        "inputmode=\"numeric\"",
        "min=\"1\"",
        "max=\"5\""
      ]
    },
    {
      "id": "dias",
      "nombre": "Días de préstamo",
      "control": "number",
      "tipoSql": "INTEGER",
      "requerido": true,
      "atributosHtml": [
        "required",
        "step=\"1\"",
        "inputmode=\"numeric\"",
        "min=\"1\"",
        "max=\"30\""
      ]
    },
    {
      "id": "motivo",
      "nombre": "Motivo",
      "control": "text",
      "tipoSql": "VARCHAR(300)",
      "requerido": true,
      "atributosHtml": [
        "required",
        "maxlength=\"300\""
      ]
    }
  ],
  "formulario": {
    "actor": "estudiante",
    "estado": "solicitado",
    "nombre": "Nueva solicitud"
  },
  "estados": [
    {
      "id": "solicitado",
      "nombre": "En revisión"
    },
    {
      "id": "aprobado",
      "nombre": "Aprobado"
    },
    {
      "id": "entregado",
      "nombre": "Entregado"
    },
    {
      "id": "devuelto",
      "nombre": "Devuelto",
      "final": true
    },
    {
      "id": "rechazado",
      "nombre": "Rechazado",
      "final": true
    }
  ],
  "acciones": [
    {
      "id": "aprobar",
      "nombre": "Aprobar",
      "actor": "responsable",
      "desde": "solicitado",
      "hasta": "aprobado"
    },
    {
      "id": "rechazar",
      "nombre": "Rechazar",
      "actor": "responsable",
      "desde": "solicitado",
      "hasta": "rechazado"
    },
    {
      "id": "entregar",
      "nombre": "Registrar entrega",
      "actor": "responsable",
      "desde": "aprobado",
      "hasta": "entregado"
    },
    {
      "id": "devolver",
      "nombre": "Registrar devolución",
      "actor": "estudiante",
      "desde": "entregado",
      "hasta": "devuelto"
    }
  ],
  "validadores": [
    {
      "id": "CantidadValida",
      "clase": "Prestamo",
      "tipo": "inv",
      "operacion": null,
      "expresion": [
        {
          "campo": "cantidad",
          "acceso": "value",
          "operador": ">=",
          "valor": 1
        },
        {
          "campo": "cantidad",
          "acceso": "value",
          "operador": "<=",
          "conector": "and",
          "valor": 5
        }
      ],
      "fuente": "context Prestamo inv CantidadValida: self.cantidad >= 1 and self.cantidad <= 5"
    },
    {
      "id": "PlazoValido",
      "clase": "Prestamo",
      "tipo": "inv",
      "operacion": null,
      "expresion": [
        {
          "campo": "dias",
          "acceso": "value",
          "operador": ">=",
          "valor": 1
        },
        {
          "campo": "dias",
          "acceso": "value",
          "operador": "<=",
          "conector": "and",
          "valor": 30
        }
      ],
      "fuente": "context Prestamo inv PlazoValido: self.dias >= 1 and self.dias <= 30"
    },
    {
      "id": "MotivoSuficiente",
      "clase": "Prestamo",
      "tipo": "pre",
      "operacion": "aprobar",
      "expresion": [
        {
          "campo": "motivo",
          "acceso": "size",
          "operador": ">=",
          "valor": 8
        }
      ],
      "fuente": "context Prestamo::aprobar() pre MotivoSuficiente: self.motivo.size() >= 8"
    }
  ],
  "integracion": {
