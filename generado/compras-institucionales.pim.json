  "restricciones": [
    {
      "id": "MontoValido",
      "clase": "Compra",
      "tipo": "inv",
      "operacion": null,
      "expresion": [
        {
          "campo": "monto",
          "acceso": "value",
          "operador": ">=",
          "valor": 1
        },
        {
          "campo": "monto",
          "acceso": "value",
          "operador": "<=",
          "valor": 250000
        }
      ],
      "fuente": "context Compra inv MontoValido: self.monto >= 1 and self.monto <= 250000"
    },
    {
      "id": "CantidadValida",
      "clase": "Compra",
      "tipo": "inv",
      "operacion": null,
      "expresion": [
        {
          "campo": "cantidad",
          "acceso": "value",
          "operador": ">=",
          "valor": 1
        },
        {
          "campo": "cantidad",
          "acceso": "value",
          "operador": "<=",
          "valor": 10000
        }
      ],
      "fuente": "context Compra inv CantidadValida: self.cantidad >= 1 and self.cantidad <= 10000"
    },
    {
      "id": "PlazoValido",
      "clase": "Compra",
      "tipo": "inv",
      "operacion": null,
      "expresion": [
        {
          "campo": "plazo",
          "acceso": "value",
          "operador": ">=",
          "valor": 1
        },
        {
          "campo": "plazo",
          "acceso": "value",
          "operador": "<=",
          "valor": 180
        }
      ],
      "fuente": "context Compra inv PlazoValido: self.plazo >= 1 and self.plazo <= 180"
    },
    {
      "id": "CotizacionesValidas",
      "clase": "Compra",
      "tipo": "inv",
      "operacion": null,
      "expresion": [
        {
          "campo": "cotizaciones",
          "acceso": "value",
          "operador": ">=",
          "valor": 0
        },
        {
          "campo": "cotizaciones",
          "acceso": "value",
          "operador": "<=",
          "valor": 30
        }
      ],
      "fuente": "context Compra inv CotizacionesValidas: self.cotizaciones >= 0 and self.cotizaciones <= 30"
    },
    {
      "id": "ReferenciaValida",
      "clase": "Compra",
      "tipo": "inv",
      "operacion": null,
      "expresion": [
        {
          "campo": "referencia",
          "acceso": "size",
          "operador": ">=",
          "valor": 4
        }
      ],
      "fuente": "context Compra inv ReferenciaValida: self.referencia.size() >= 4"
    },
    {
      "id": "JustificacionSuficiente",
      "clase": "Compra",
      "tipo": "pre",
      "operacion": "avalar",
      "expresion": [
        {
          "campo": "justificacion",
          "acceso": "size",
          "operador": ">=",
          "valor": 20
        }
      ],
      "fuente": "context Compra::avalar() pre JustificacionSuficiente: self.justificacion.size() >= 20"
    },
    {
      "id": "PartidaIdentificada",
      "clase": "Compra",
      "tipo": "pre",
      "operacion": "certificar",
      "expresion": [
        {
          "campo": "partida",
          "acceso": "size",
          "operador": ">=",
          "valor": 4
        }
      ],
      "fuente": "context Compra::certificar() pre PartidaIdentificada: self.partida.size() >= 4"
    },
    {
      "id": "MontoCompraDirecta",
      "clase": "Compra",
      "tipo": "pre",
      "operacion": "directa",
      "expresion": [
        {
          "campo": "monto",
          "acceso": "value",
          "operador": "<",
          "valor": 10000
        },
        {
          "campo": "cotizaciones",
          "acceso": "value",
          "operador": ">=",
          "valor": 1
        }
      ],
      "fuente": "context Compra::directa() pre MontoCompraDirecta: self.monto < 10000 and self.cotizaciones >= 1"
    },
    {
      "id": "UmbralCompetitivo",
      "clase": "Compra",
      "tipo": "pre",
      "operacion": "competitiva",
      "expresion": [
        {
          "campo": "monto",
          "acceso": "value",
          "operador": ">=",
          "valor": 10000
        },
        {
          "campo": "cotizaciones",
          "acceso": "value",
          "operador": ">=",
          "valor": 3
        }
      ],
      "fuente": "context Compra::competitiva() pre UmbralCompetitivo: self.monto >= 10000 and self.cotizaciones >= 3"
    },
    {
      "id": "CotizacionesComite",
      "clase": "Compra",
      "tipo": "pre",
      "operacion": "adjudicar",
      "expresion": [
        {
          "campo": "cotizaciones",
          "acceso": "value",
          "operador": ">=",
          "valor": 3
        }
      ],
      "fuente": "context Compra::adjudicar() pre CotizacionesComite: self.cotizaciones >= 3"
    },
    {
      "id": "ProveedorIdentificado",
      "clase": "Compra",
      "tipo": "pre",
      "operacion": "emitir",
      "expresion": [
        {
          "campo": "proveedor",
          "acceso": "size",
          "operador": ">=",
          "valor": 3
        }
      ],
      "fuente": "context Compra::emitir() pre ProveedorIdentificado: self.proveedor.size() >= 3"
    },
    {
      "id": "ReferenciaContable",
      "clase": "Compra",
      "tipo": "pre",
      "operacion": "contabilizar",
      "expresion": [
        {
          "campo": "referencia",
          "acceso": "size",
          "operador": ">=",
          "valor": 6
        }
      ],
      "fuente": "context Compra::contabilizar() pre ReferenciaContable: self.referencia.size() >= 6"
    }
  ]
}
