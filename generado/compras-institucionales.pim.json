    {
      "id": "contabilizar",
      "nombre": "Autorizar contabilización",
      "actor": "contabilidad",
      "desde": "contabilidad",
      "hasta": "pago"
    },
    {
      "id": "revisar",
      "nombre": "Devolver expediente",
      "actor": "contabilidad",
      "desde": "contabilidad",
      "hasta": "recibida"
    },
    {
      "id": "pagar",
      "nombre": "Registrar pago",
      "actor": "tesoreria",
      "desde": "pago",
      "hasta": "pagada"
