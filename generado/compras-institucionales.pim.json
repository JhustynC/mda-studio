      "desde": "solicitada",
      "hasta": "presupuesto"
    },
    {
      "id": "observar",
      "nombre": "Solicitar ampliación",
      "actor": "jefatura",
      "desde": "solicitada",
      "hasta": "observada"
    },
    {
      "id": "justificar",
      "nombre": "Registrar ampliación externa",
      "actor": "solicitante",
      "desde": "observada",
      "hasta": "solicitada"
    },
    {
      "id": "retirar",
      "nombre": "Retirar solicitud",
      "actor": "solicitante",
      "desde": "observada",
      "hasta": "cancelada"
    },
    {
      "id": "denegar",
      "nombre": "Rechazar solicitud",
      "actor": "jefatura",
      "desde": "solicitada",
      "hasta": "rechazada"
    },
    {
      "id": "certificar",
      "nombre": "Certificar disponibilidad",
      "actor": "presupuesto",
      "desde": "presupuesto",
      "hasta": "modalidad"
    },
    {
      "id": "sinfondos",
      "nombre": "Rechazar por falta de fondos",
      "actor": "presupuesto",
      "desde": "presupuesto",
      "hasta": "rechazada"
    },
    {
      "id": "directa",
      "nombre": "Adjudicar compra directa",
      "actor": "compras",
      "desde": "modalidad",
      "hasta": "adjudicada"
    },
    {
      "id": "competitiva",
      "nombre": "Enviar a revisión jurídica",
      "actor": "compras",
      "desde": "modalidad",
      "hasta": "juridica"
    },
    {
      "id": "cancelar",
      "nombre": "Cancelar trámite",
      "actor": "compras",
      "desde": "modalidad",
      "hasta": "cancelada"
    },
    {
      "id": "dictamen",
      "nombre": "Emitir dictamen favorable",
      "actor": "juridico",
      "desde": "juridica",
      "hasta": "comite"
    },
    {
      "id": "devolver",
      "nombre": "Devolver a compras",
      "actor": "juridico",
      "desde": "juridica",
      "hasta": "modalidad"
    },
    {
      "id": "objecion",
      "nombre": "Rechazar por objeción jurídica",
      "actor": "juridico",
      "desde": "juridica",
      "hasta": "rechazada"
    },
    {
      "id": "adjudicar",
      "nombre": "Adjudicar por comité",
      "actor": "comite",
      "desde": "comite",
      "hasta": "adjudicada"
    },
    {
      "id": "desierta",
      "nombre": "Declarar proceso desierto",
      "actor": "comite",
      "desde": "comite",
      "hasta": "cancelada"
    },
    {
      "id": "emitir",
      "nombre": "Emitir orden de compra",
      "actor": "compras",
      "desde": "adjudicada",
      "hasta": "ordenada"
    },
    {
      "id": "recibir",
      "nombre": "Confirmar recepción conforme",
      "actor": "bodega",
      "desde": "ordenada",
      "hasta": "recibida"
    },
    {
      "id": "incidencia",
      "nombre": "Registrar recepción no conforme",
      "actor": "bodega",
      "desde": "ordenada",
      "hasta": "incidencia"
    },
    {
      "id": "subsanar",
      "nombre": "Registrar subsanación del proveedor",
      "actor": "compras",
      "desde": "incidencia",
      "hasta": "ordenada"
    },
    {
      "id": "anular",
      "nombre": "Anular orden",
      "actor": "compras",
      "desde": "incidencia",
      "hasta": "cancelada"
    },
    {
      "id": "enviarcontable",
      "nombre": "Enviar expediente a contabilidad",
      "actor": "compras",
      "desde": "recibida",
      "hasta": "contabilidad"
