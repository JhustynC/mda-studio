{
  "id": "inventario",
  "nombre": "Inventario de laboratorio",
  "objetivo": "Consulta y actualiza el catálogo de productos y sus existencias.",
  "entidad": "Producto",
  "plataforma": "HTML5 / JavaScript ES2022 / IndexedDB + File System Access API + SQL DDL",
  "tipo": "crud",
  "presentacion": "tabla",
  "arquitectura": {
    "patronUi": "Data Grid CRUD Tabular (Formulario + Tabla Filtrable)",
    "disposicion": "Formulario de captura multi-columna superior + Tabla de registros con búsqueda instantánea y diálogo de confirmación de borrado.",
    "contenedores": [
      "Formulario de Alta/Edición (7 controles)",
      "Barra de búsqueda en tiempo real",
      "Tabla de datos con columnas: Producto, Código SKU, Categoría, Stock disponible, Ubicación, Fecha de reposición, Producto activo + Acciones",
      "Gestión de datos y exportación"
    ],
    "adaptadorDatos": "IndexedDB y localStorage en el navegador. Copias JSON y exportación SQL.",
    "seguridad": "Validación de unicidad (sku) e invariantes OCL en cliente antes de confirmar transacción"
  },
  "almacen": {
    "tipo": "IndexedDB + localStorage",
    "clave": "mda.registros.proyecto.example-inventario.inventario"
  },
  "esquemaSql": {
    "motor": "SQLite 3",
    "tablas": [
      {
        "nombre": "producto",
        "descripcion": "Tabla de catálogo CRUD para Producto",
        "columnas": [
          {
            "nombre": "id",
            "tipo": "VARCHAR(64)",
            "restricciones": "PRIMARY KEY NOT NULL"
          },
          {
            "nombre": "nombre",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "sku",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL UNIQUE"
          },
          {
            "nombre": "categoria",
            "tipo": "VARCHAR(64)",
            "restricciones": "NOT NULL CHECK (categoria IN ('equipos', 'consumibles', 'repuestos'))"
          },
          {
            "nombre": "stock",
            "tipo": "INTEGER",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "ubicacion",
            "tipo": "VARCHAR(300)",
            "restricciones": "NULL"
          },
          {
            "nombre": "reposicion",
            "tipo": "DATE",
            "restricciones": "NULL"
          },
          {
            "nombre": "activo",
            "tipo": "BOOLEAN",
            "restricciones": "NULL"
          }
        ],
        "checks": [
          "CONSTRAINT chk_stocknonegativo CHECK (stock >= 0)"
        ]
      }
    ]
  },
  "campos": [
    {
      "id": "nombre",
      "nombre": "Producto",
      "control": "text",
      "tipoSql": "VARCHAR(300)",
      "requerido": true,
      "atributosHtml": [
        "required",
        "maxlength=\"300\""
      ]
    },
    {
      "id": "sku",
      "nombre": "Código SKU",
      "control": "text",
      "tipoSql": "VARCHAR(300)",
      "requerido": true,
      "atributosHtml": [
        "required",
        "maxlength=\"300\""
      ]
    },
    {
      "id": "categoria",
      "nombre": "Categoría",
      "control": "select",
      "tipoSql": "VARCHAR(64)",
      "requerido": true,
      "atributosHtml": [
        "required"
      ],
      "opciones": [
        {
          "id": "equipos",
          "nombre": "Equipos"
        },
        {
          "id": "consumibles",
          "nombre": "Consumibles"
        },
        {
          "id": "repuestos",
          "nombre": "Repuestos"
        }
      ]
    },
    {
      "id": "stock",
      "nombre": "Stock disponible",
      "control": "number",
      "tipoSql": "INTEGER",
      "requerido": true,
      "atributosHtml": [
        "required",
        "step=\"1\"",
        "inputmode=\"numeric\"",
        "min=\"0\""
      ]
    },
    {
      "id": "ubicacion",
      "nombre": "Ubicación",
      "control": "text",
      "tipoSql": "VARCHAR(300)",
      "requerido": false,
      "atributosHtml": [
        "maxlength=\"300\""
      ]
    },
    {
      "id": "reposicion",
      "nombre": "Fecha de reposición",
      "control": "date",
      "tipoSql": "DATE",
      "requerido": false,
      "atributosHtml": []
    },
    {
      "id": "activo",
      "nombre": "Producto activo",
      "control": "checkbox",
      "tipoSql": "BOOLEAN",
      "requerido": false,
      "atributosHtml": []
    }
  ],
  "unicos": [
    "sku"
  ],
  "acciones": [
    "crear",
    "consultar",
    "editar",
    "eliminar"
  ],
  "validadores": [
    {
      "id": "StockNoNegativo",
      "clase": "Producto",
      "tipo": "inv",
      "operacion": null,
      "expresion": [
        {
          "campo": "stock",
          "acceso": "value",
          "operador": ">=",
          "valor": 0
        }
      ],
      "fuente": "context Producto inv StockNoNegativo: self.stock >= 0"
    }
  ]
}
