    },
    {
      "id": "rechazar",
      "nombre": "Rechazar",
      "actor": "responsable",
      "desde": "solicitado",
      "hasta": "rechazado"
    },
    {
      "id": "entregar",
      "nombre": "Registrar entrega",
      "actor": "responsable",
      "desde": "aprobado",
      "hasta": "entregado"
    },
    {
      "id": "devolver",
      "nombre": "Registrar devolución",
      "actor": "estudiante",
      "desde": "entregado",
      "hasta": "devuelto"
    }
  ],
  "firmas": [
    {
      "id": "iniciar-caso",
      "nombre": "Nueva solicitud",
      "visibilidad": "public",
      "actor": "estudiante",
      "desde": null,
      "hasta": "solicitado",
      "parametros": [
        "actor: Rol",
        "solicitante: EString",
        "equipo: EString",
        "cantidad: EInt",
        "dias: EInt",
        "motivo: EString"
      ],
      "retorno": "Prestamo",
      "guardas": [
        "CantidadValida",
        "PlazoValido"
      ],
      "efectos": [
        "Inicializa estado en solicitado",
        "Registra evento de creación en historial"
      ]
    },
    {
      "id": "aprobar",
      "nombre": "Aprobar",
      "visibilidad": "public",
      "actor": "responsable",
      "desde": "solicitado",
      "hasta": "aprobado",
      "parametros": [
        "idCaso: EString",
        "actor: Rol"
      ],
      "retorno": "EBoolean",
      "guardas": [
        "CantidadValida",
        "PlazoValido",
        "MotivoSuficiente"
      ],
      "efectos": [
        "Cambia estado: solicitado → aprobado",
        "Anexa evento auditado por rol responsable"
      ]
    },
    {
      "id": "rechazar",
      "nombre": "Rechazar",
      "visibilidad": "public",
      "actor": "responsable",
      "desde": "solicitado",
      "hasta": "rechazado",
      "parametros": [
        "idCaso: EString",
        "actor: Rol"
      ],
      "retorno": "EBoolean",
      "guardas": [
        "CantidadValida",
        "PlazoValido"
      ],
      "efectos": [
        "Cambia estado: solicitado → rechazado",
        "Anexa evento auditado por rol responsable"
      ]
    },
    {
      "id": "entregar",
      "nombre": "Registrar entrega",
      "visibilidad": "public",
      "actor": "responsable",
      "desde": "aprobado",
      "hasta": "entregado",
      "parametros": [
        "idCaso: EString",
        "actor: Rol"
      ],
      "retorno": "EBoolean",
      "guardas": [
        "CantidadValida",
        "PlazoValido"
      ],
      "efectos": [
        "Cambia estado: aprobado → entregado",
        "Anexa evento auditado por rol responsable"
      ]
    },
    {
      "id": "devolver",
      "nombre": "Registrar devolución",
      "visibilidad": "public",
      "actor": "estudiante",
      "desde": "entregado",
      "hasta": "devuelto",
      "parametros": [
        "idCaso: EString",
        "actor: Rol"
      ],
      "retorno": "EBoolean",
      "guardas": [
        "CantidadValida",
        "PlazoValido"
      ],
      "efectos": [
        "Cambia estado: entregado → devuelto",
        "Anexa evento auditado por rol estudiante"
      ]
    }
  ],
  "relaciones": [
    {
      "origen": "Prestamo",
      "destino": "EventoHistorial",
      "multiplicidadOrigen": "1..1",
      "multiplicidadDestino": "1..*",
      "rol": "historial",
      "tipo": "composicion"
    },
    {
      "origen": "ActorRol",
      "destino": "Prestamo",
      "multiplicidadOrigen": "1..1",
      "multiplicidadDestino": "0..*",
      "rol": "ejecutaTransiciones",
      "tipo": "asociacion"
    }
  ],
  "restricciones": [
    {
      "id": "CantidadValida",
      "clase": "Prestamo",
      "tipo": "inv",
      "operacion": null,
      "expresion": [
        {
          "campo": "cantidad",
          "acceso": "value",
          "operador": ">=",
          "valor": 1
        },
        {
          "campo": "cantidad",
          "acceso": "value",
          "operador": "<=",
          "conector": "and",
          "valor": 5
        }
      ],
      "fuente": "context Prestamo inv CantidadValida: self.cantidad >= 1 and self.cantidad <= 5"
    },
    {
      "id": "PlazoValido",
      "clase": "Prestamo",
      "tipo": "inv",
      "operacion": null,
      "expresion": [
        {
          "campo": "dias",
          "acceso": "value",
          "operador": ">=",
          "valor": 1
        },
        {
          "campo": "dias",
          "acceso": "value",
          "operador": "<=",
          "conector": "and",
          "valor": 30
        }
      ],
      "fuente": "context Prestamo inv PlazoValido: self.dias >= 1 and self.dias <= 30"
    },
    {
      "id": "MotivoSuficiente",
      "clase": "Prestamo",
      "tipo": "pre",
      "operacion": "aprobar",
      "expresion": [
        {
          "campo": "motivo",
          "acceso": "size",
          "operador": ">=",
          "valor": 8
        }
      ],
      "fuente": "context Prestamo::aprobar() pre MotivoSuficiente: self.motivo.size() >= 8"
    }
  ]
}
