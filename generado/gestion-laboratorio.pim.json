          "operador": ">=",
          "valor": 1
        },
        {
          "campo": "dias",
          "acceso": "value",
          "operador": "<=",
          "conector": "and",
          "valor": 30
        }
      ],
      "fuente": "context Prestamo inv PlazoValido: self.dias >= 1 and self.dias <= 30"
    },
    {
      "id": "MotivoSuficiente",
      "clase": "Prestamo",
      "tipo": "pre",
      "operacion": "aprobar",
      "expresion": [
        {
          "campo": "motivo",
          "acceso": "size",
          "operador": ">=",
          "valor": 8
        }
      ],
      "fuente": "context Prestamo::aprobar() pre MotivoSuficiente: self.motivo.size() >= 8"
    },
    {
      "id": "MotivoCorregido",
      "clase": "Prestamo",
      "tipo": "pre",
      "operacion": "corregir",
      "expresion": [
        {
          "campo": "motivo",
          "acceso": "size",
          "operador": ">=",
          "valor": 8
        }
      ],
      "fuente": "context Prestamo::corregir() pre MotivoCorregido: self.motivo.size() >= 8"
    }
  ],
