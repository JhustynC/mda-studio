<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="gestion_laboratorio"
    nsURI="http://mda.studio/models/gestion-laboratorio/1.0"
    nsPrefix="gestion_laboratorio">
  <eClassifiers xsi:type="ecore:EClass" name="Prestamo">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="CantidadValida PlazoValido MotivoSuficiente MotivoCorregido"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="CantidadValida" value="context Prestamo inv CantidadValida: self.cantidad &gt;= 1 and self.cantidad &lt;= 5"/>
      <details key="PlazoValido" value="context Prestamo inv PlazoValido: self.dias &gt;= 1 and self.dias &lt;= 30"/>
      <details key="MotivoSuficiente" value="context Prestamo::aprobar() pre MotivoSuficiente: self.motivo.size() &gt;= 8"/>
      <details key="MotivoCorregido" value="context Prestamo::corregir() pre MotivoCorregido: self.motivo.size() &gt;= 8"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" upperBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="estado-actual" lowerBound="1" upperBound="1" eType="#//Prestamo_estado-actual"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="solicitante" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="equipo" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cantidad" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dias" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="motivo" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="equipoRef" lowerBound="1" upperBound="1" eType="#//Producto"/>
    <eOperations name="iniciar-caso" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="guards" value="CantidadValida, PlazoValido"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="aprobar" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="guards" value="CantidadValida, PlazoValido, MotivoSuficiente"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="pedir-correccion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="guards" value="CantidadValida, PlazoValido"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="corregir" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="guards" value="CantidadValida, PlazoValido, MotivoCorregido"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="rechazar" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="guards" value="CantidadValida, PlazoValido"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="entregar" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="guards" value="CantidadValida, PlazoValido"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="devolver" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="guards" value="CantidadValida, PlazoValido"/>
      </eAnnotations>
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Prestamo_estado-actual">
    <eLiterals name="solicitado" value="0" literal="solicitado"/>
    <eLiterals name="en-correccion" value="1" literal="en-correccion"/>
    <eLiterals name="aprobado" value="2" literal="aprobado"/>
    <eLiterals name="entregado" value="3" literal="entregado"/>
    <eLiterals name="devuelto" value="4" literal="devuelto"/>
    <eLiterals name="rechazado" value="5" literal="rechazado"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Producto">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="StockNoNegativo"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="StockNoNegativo" value="context Producto inv StockNoNegativo: self.stock &gt;= 0"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" upperBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nombre" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sku" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="categoria" lowerBound="1" upperBound="1" eType="#//Producto_categoria"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stock" lowerBound="1" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ubicacion" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reposicion" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="activo" lowerBound="0" upperBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eOperations name="crear" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="guards" value="StockNoNegativo"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="consultar" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
    </eOperations>
    <eOperations name="editar" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="guards" value="StockNoNegativo"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="eliminar" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Producto_categoria">
    <eLiterals name="equipos" value="0" literal="equipos"/>
    <eLiterals name="consumibles" value="1" literal="consumibles"/>
    <eLiterals name="repuestos" value="2" literal="repuestos"/>
  </eClassifiers>
</ecore:EPackage>
