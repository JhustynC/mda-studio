{
  "id": "compras-institucionales",
  "nombre": "Compras institucionales",
  "objetivo": "Tramitar compras universitarias desde la solicitud y el control presupuestario hasta la recepción, el pago y el cierre.",
  "entidad": "Compra",
  "plataforma": "HTML5 / JavaScript ES2022 / IndexedDB + File System Access API + SQL DDL",
  "presentacion": "tablero",
  "arquitectura": {
    "patronUi": "Tablero Kanban por Estado (State-Lane Board)",
    "disposicion": "Grid horizontal de carriles agrupados por cada estado de la máquina de estados (16 columnas) + panel de formulario e inspector.",
    "contenedores": [
      "Cabecera con selector de rol de demostración (Solicitante, Jefatura, Presupuesto, Compras, Jurídico, Comité, Bodega, Contabilidad, Tesorería)",
      "Tablero Kanban con 16 carriles de estado: Revisión de jefatura | Ampliación pendiente | Control de presupuesto | Selección de modalidad | Revisión jurídica | Evaluación del comité | Adjudicada | Orden emitida | Incidencia de recepción | Recibida | Revisión contable | Pendiente de pago | Pagada | Cerrada [Final] | Rechazada [Final] | Cancelada [Final]",
      "Formulario de creación para rol inicial (solicitante)",
      "Inspector lateral de caso seleccionado + Botonera de transiciones + Historial",
      "Gestión de datos y exportación"
    ],
    "adaptadorDatos": "IndexedDB y localStorage en el navegador. Copias JSON y exportación SQL.",
    "seguridad": "Simulación de roles en cliente para 9 actores y 12 validadores OCL compilados a ES2022"
  },
  "almacen": {
    "tipo": "IndexedDB + localStorage",
    "clave": "mda.casos.proyecto.example-compras.compras-institucionales"
  },
  "esquemaSql": {
    "motor": "SQLite 3",
    "tablas": [
      {
        "nombre": "compra",
        "descripcion": "Tabla principal de casos de proceso para Compra",
        "columnas": [
          {
            "nombre": "id",
            "tipo": "VARCHAR(64)",
            "restricciones": "PRIMARY KEY NOT NULL"
          },
          {
            "nombre": "estado_actual",
            "tipo": "VARCHAR(48)",
            "restricciones": "NOT NULL DEFAULT 'solicitada'"
          },
          {
            "nombre": "referencia",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "unidad",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "objeto",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "justificacion",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "monto",
            "tipo": "INTEGER",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "cantidad",
            "tipo": "INTEGER",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "cotizaciones",
            "tipo": "INTEGER",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "plazo",
            "tipo": "INTEGER",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "proveedor",
            "tipo": "VARCHAR(300)",
            "restricciones": "NULL"
          },
          {
            "nombre": "partida",
            "tipo": "VARCHAR(300)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "prioridad",
            "tipo": "VARCHAR(64)",
            "restricciones": "CHECK (prioridad IN ('normal', 'urgente', 'critica'))"
          },
          {
            "nombre": "fecha_necesaria",
            "tipo": "DATE",
            "restricciones": "NULL"
          },
          {
            "nombre": "documentacion",
            "tipo": "BOOLEAN",
            "restricciones": "NULL"
          }
        ],
        "checks": [
          "CONSTRAINT chk_compra_estado CHECK (estado_actual IN ('solicitada', 'observada', 'presupuesto', 'modalidad', 'juridica', 'comite', 'adjudicada', 'ordenada', 'incidencia', 'recibida', 'contabilidad', 'pago', 'pagada', 'cerrada', 'rechazada', 'cancelada'))",
          "CONSTRAINT chk_montovalido CHECK (monto >= 1 AND monto <= 250000)",
          "CONSTRAINT chk_cantidadvalida CHECK (cantidad >= 1 AND cantidad <= 10000)",
          "CONSTRAINT chk_plazovalido CHECK (plazo >= 1 AND plazo <= 180)",
          "CONSTRAINT chk_cotizacionesvalidas CHECK (cotizaciones >= 0 AND cotizaciones <= 30)",
          "CONSTRAINT chk_referenciavalida CHECK (CHAR_LENGTH(referencia) >= 4)"
        ]
      },
      {
        "nombre": "compra_historial",
        "descripcion": "Bitácora inmutable de auditoría de transiciones por rol",
        "columnas": [
          {
            "nombre": "id_evento",
            "tipo": "INTEGER",
            "restricciones": "PRIMARY KEY AUTOINCREMENT"
          },
          {
            "nombre": "caso_id",
            "tipo": "VARCHAR(64)",
            "restricciones": "NOT NULL REFERENCES compra(id) ON DELETE CASCADE"
          },
          {
            "nombre": "accion",
            "tipo": "VARCHAR(120)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "rol_actor",
            "tipo": "VARCHAR(64)",
            "restricciones": "NOT NULL"
          },
          {
            "nombre": "fecha_hora",
            "tipo": "TIMESTAMP",
            "restricciones": "NOT NULL DEFAULT CURRENT_TIMESTAMP"
          }
        ],
        "checks": []
      }
    ]
  },
