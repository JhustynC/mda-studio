{
  "version": 1,
  "id": "gestion-laboratorio",
  "nombre": "Gestión de laboratorio",
  "objetivo": "Administra equipos y tramita préstamos con existencias compartidas.",
  "entidad": "Prestamo",
  "actores": [
    {
      "id": "estudiante",
      "nombre": "Estudiante"
    },
    {
      "id": "responsable",
      "nombre": "Responsable"
    }
  ],
  "datos": [
    {
      "id": "solicitante",
      "nombre": "Solicitante",
      "tipo": "Texto",
      "requerido": true
    },
    {
      "id": "equipo",
      "nombre": "Equipo del inventario",
      "tipo": "Texto",
      "requerido": true
    },
    {
      "id": "cantidad",
      "nombre": "Cantidad",
      "tipo": "Entero",
      "requerido": true
    },
    {
      "id": "dias",
      "nombre": "Días de préstamo",
      "tipo": "Entero",
      "requerido": true
    },
    {
      "id": "motivo",
      "nombre": "Motivo",
      "tipo": "Texto",
      "requerido": true
    }
  ],
  "inicio": {
    "actor": "estudiante",
    "estado": "solicitado",
    "nombre": "Nueva solicitud"
  },
  "estados": [
    {
      "id": "solicitado",
      "nombre": "En revisión"
    },
    {
      "id": "en-correccion",
      "nombre": "En corrección"
    },
    {
      "id": "aprobado",
      "nombre": "Aprobado"
    },
    {
      "id": "entregado",
      "nombre": "Entregado"
    },
    {
      "id": "devuelto",
      "nombre": "Devuelto",
      "final": true
    },
    {
      "id": "rechazado",
      "nombre": "Rechazado",
      "final": true
    }
  ],
  "transiciones": [
    {
      "id": "aprobar",
      "nombre": "Aprobar",
      "actor": "responsable",
      "desde": "solicitado",
      "hasta": "aprobado"
    },
    {
      "id": "pedir-correccion",
      "nombre": "Pedir corrección",
      "actor": "responsable",
      "desde": "solicitado",
      "hasta": "en-correccion",
      "comentario": true
    },
    {
      "id": "corregir",
      "nombre": "Corregir y reenviar",
      "actor": "estudiante",
      "desde": "en-correccion",
      "hasta": "solicitado",
      "edita": ["solicitante", "equipo", "cantidad", "dias", "motivo"]
    },
    {
      "id": "rechazar",
      "nombre": "Rechazar",
      "actor": "responsable",
      "desde": "solicitado",
      "hasta": "rechazado"
    },
    {
      "id": "entregar",
      "nombre": "Registrar entrega",
      "actor": "responsable",
      "desde": "aprobado",
      "hasta": "entregado"
    },
    {
      "id": "devolver",
      "nombre": "Registrar devolución",
      "actor": "estudiante",
      "desde": "entregado",
      "hasta": "devuelto"
    }
  ],
  "ocl": [
    "context Prestamo inv CantidadValida: self.cantidad >= 1 and self.cantidad <= 5",
    "context Prestamo inv PlazoValido: self.dias >= 1 and self.dias <= 30",
    "context Prestamo::aprobar() pre MotivoSuficiente: self.motivo.size() >= 8",
    "context Prestamo::corregir() pre MotivoCorregido: self.motivo.size() >= 8"
  ],
  "integracion": {
    "catalogo": {
      "version": 1,
      "tipo": "crud",
      "id": "inventario",
      "nombre": "Inventario compartido",
      "objetivo": "Consulta y actualiza el catálogo de productos y sus existencias.",
      "entidad": "Producto",
      "datos": [
        {
          "id": "nombre",
          "nombre": "Producto",
          "tipo": "Texto",
          "requerido": true
        },
        {
          "id": "sku",
          "nombre": "Código SKU",
          "tipo": "Texto",
          "requerido": true
        },
        {
          "id": "categoria",
          "nombre": "Categoría",
          "tipo": "Seleccion",
          "requerido": true,
          "opciones": [
            {
              "id": "equipos",
              "nombre": "Equipos"
            },
            {
              "id": "consumibles",
              "nombre": "Consumibles"
            },
            {
              "id": "repuestos",
              "nombre": "Repuestos"
            }
          ]
        },
        {
          "id": "stock",
          "nombre": "Stock disponible",
          "tipo": "Entero",
          "requerido": true
        },
        {
          "id": "ubicacion",
          "nombre": "Ubicación",
          "tipo": "Texto"
        },
        {
          "id": "reposicion",
          "nombre": "Fecha de reposición",
          "tipo": "Fecha"
        },
        {
          "id": "activo",
          "nombre": "Producto activo",
          "tipo": "Booleano"
        }
      ],
      "unicos": [
        "sku"
      ],
      "ocl": [
        "context Producto inv StockNoNegativo: self.stock >= 0"
      ]
    },
    "referencia": "equipo",
    "clave": "sku",
    "existencias": "stock",
    "cantidad": "cantidad",
    "activo": "activo",
    "movimientos": [
      {
        "transicion": "entregar",
        "tipo": "salida"
      },
      {
        "transicion": "devolver",
        "tipo": "entrada"
      }
    ]
  }
}
