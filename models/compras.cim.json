    {
      "id": "unidad",
      "nombre": "Unidad solicitante",
      "tipo": "Texto",
      "requerido": true
    },
    {
      "id": "objeto",
      "nombre": "Objeto de la compra",
      "tipo": "Texto",
      "requerido": true
    },
    {
      "id": "justificacion",
      "nombre": "Justificación",
      "tipo": "Texto",
      "requerido": true
    },
    {
      "id": "monto",
      "nombre": "Monto estimado (USD)",
      "tipo": "Entero",
      "requerido": true
    },
    {
      "id": "cantidad",
      "nombre": "Unidades",
      "tipo": "Entero",
      "requerido": true
    },
    {
      "id": "cotizaciones",
      "nombre": "Cotizaciones disponibles",
      "tipo": "Entero",
      "requerido": true
    },
    {
      "id": "plazo",
      "nombre": "Plazo de entrega (días)",
      "tipo": "Entero",
      "requerido": true
    },
    {
      "id": "proveedor",
      "nombre": "Proveedor propuesto",
      "tipo": "Texto",
      "requerido": false
    },
    {
      "id": "partida",
      "nombre": "Partida presupuestaria",
      "tipo": "Texto",
      "requerido": true
    },
    {
      "id": "prioridad",
      "tipo": "Seleccion",
      "opciones": [
        {
          "nombre": "Normal",
          "id": "normal"
        },
        {
          "nombre": "Urgente",
          "id": "urgente"
        },
        {
          "nombre": "Crítica",
          "id": "critica"
        }
      ],
      "requerido": false,
      "nombre": "Prioridad"
    },
    {
      "id": "fecha-necesaria",
      "tipo": "Fecha",
      "requerido": false,
      "nombre": "Fecha en que se necesita"
    },
    {
      "id": "documentacion",
      "tipo": "Booleano",
      "requerido": false,
      "nombre": "Documentación adjunta disponible"
    }
  ],
  "inicio": {
    "actor": "solicitante",
    "estado": "solicitada",
    "nombre": "Registrar solicitud"
  },
  "estados": [
    {
      "id": "solicitada",
      "nombre": "Revisión de jefatura"
    },
    {
      "id": "observada",
      "nombre": "Ampliación pendiente"
    },
    {
      "id": "presupuesto",
      "nombre": "Control de presupuesto"
    },
    {
      "id": "modalidad",
      "nombre": "Selección de modalidad"
    },
    {
      "id": "juridica",
      "nombre": "Revisión jurídica"
    },
    {
      "id": "comite",
      "nombre": "Evaluación del comité"
    },
    {
      "id": "adjudicada",
      "nombre": "Adjudicada"
    },
    {
      "id": "ordenada",
      "nombre": "Orden emitida"
    },
    {
      "id": "incidencia",
      "nombre": "Incidencia de recepción"
    },
    {
      "id": "recibida",
      "nombre": "Recibida"
    },
    {
      "id": "contabilidad",
      "nombre": "Revisión contable"
    },
    {
      "id": "pago",
      "nombre": "Pendiente de pago"
    },
    {
      "id": "pagada",
      "nombre": "Pagada"
    },
    {
      "id": "cerrada",
      "nombre": "Cerrada",
      "final": true
    },
    {
      "id": "rechazada",
      "nombre": "Rechazada",
      "final": true
    },
    {
      "id": "cancelada",
      "nombre": "Cancelada",
      "final": true
    }
  ],
  "transiciones": [
    {
      "id": "avalar",
      "nombre": "Enviar a presupuesto",
      "actor": "jefatura",
      "desde": "solicitada",
      "hasta": "presupuesto"
    },
    {
      "id": "observar",
      "nombre": "Solicitar ampliación",
      "actor": "jefatura",
      "desde": "solicitada",
      "hasta": "observada"
    },
    {
      "id": "justificar",
      "nombre": "Registrar ampliación externa",
      "actor": "solicitante",
      "desde": "observada",
      "hasta": "solicitada"
    },
    {
      "id": "retirar",
      "nombre": "Retirar solicitud",
      "actor": "solicitante",
      "desde": "observada",
      "hasta": "cancelada"
    },
    {
      "id": "denegar",
      "nombre": "Rechazar solicitud",
      "actor": "jefatura",
      "desde": "solicitada",
      "hasta": "rechazada"
    },
    {
      "id": "certificar",
      "nombre": "Certificar disponibilidad",
      "actor": "presupuesto",
      "desde": "presupuesto",
      "hasta": "modalidad"
    },
    {
      "id": "sinfondos",
      "nombre": "Rechazar por falta de fondos",
      "actor": "presupuesto",
      "desde": "presupuesto",
      "hasta": "rechazada"
    },
    {
      "id": "directa",
      "nombre": "Adjudicar compra directa",
      "actor": "compras",
      "desde": "modalidad",
      "hasta": "adjudicada"
    },
    {
      "id": "competitiva",
      "nombre": "Enviar a revisión jurídica",
      "actor": "compras",
      "desde": "modalidad",
      "hasta": "juridica"
    },
    {
      "id": "cancelar",
      "nombre": "Cancelar trámite",
      "actor": "compras",
      "desde": "modalidad",
      "hasta": "cancelada"
    },
    {
      "id": "dictamen",
      "nombre": "Emitir dictamen favorable",
      "actor": "juridico",
      "desde": "juridica",
      "hasta": "comite"
    },
    {
      "id": "devolver",
      "nombre": "Devolver a compras",
      "actor": "juridico",
      "desde": "juridica",
      "hasta": "modalidad"
    },
    {
      "id": "objecion",
      "nombre": "Rechazar por objeción jurídica",
      "actor": "juridico",
      "desde": "juridica",
      "hasta": "rechazada"
    },
    {
      "id": "adjudicar",
      "nombre": "Adjudicar por comité",
      "actor": "comite",
      "desde": "comite",
      "hasta": "adjudicada"
    },
    {
      "id": "desierta",
      "nombre": "Declarar proceso desierto",
      "actor": "comite",
      "desde": "comite",
      "hasta": "cancelada"
    },
    {
      "id": "emitir",
      "nombre": "Emitir orden de compra",
      "actor": "compras",
      "desde": "adjudicada",
      "hasta": "ordenada"
    },
    {
      "id": "recibir",
      "nombre": "Confirmar recepción conforme",
      "actor": "bodega",
      "desde": "ordenada",
      "hasta": "recibida"
    },
    {
      "id": "incidencia",
      "nombre": "Registrar recepción no conforme",
      "actor": "bodega",
      "desde": "ordenada",
      "hasta": "incidencia"
    },
    {
      "id": "subsanar",
      "nombre": "Registrar subsanación del proveedor",
      "actor": "compras",
      "desde": "incidencia",
      "hasta": "ordenada"
    },
    {
      "id": "anular",
      "nombre": "Anular orden",
      "actor": "compras",
      "desde": "incidencia",
      "hasta": "cancelada"
    },
    {
      "id": "enviarcontable",
      "nombre": "Enviar expediente a contabilidad",
      "actor": "compras",
      "desde": "recibida",
      "hasta": "contabilidad"
    },
    {
      "id": "contabilizar",
      "nombre": "Autorizar contabilización",
      "actor": "contabilidad",
      "desde": "contabilidad",
      "hasta": "pago"
    },
    {
      "id": "revisar",
      "nombre": "Devolver expediente",
      "actor": "contabilidad",
      "desde": "contabilidad",
      "hasta": "recibida"
    },
    {
      "id": "pagar",
      "nombre": "Registrar pago",
      "actor": "tesoreria",
      "desde": "pago",
      "hasta": "pagada"
    },
    {
      "id": "cerrar",
      "nombre": "Cerrar expediente",
      "actor": "compras",
      "desde": "pagada",
      "hasta": "cerrada"
    }
  ],
  "ocl": [
    "context Compra inv MontoValido: self.monto >= 1 and self.monto <= 250000",
    "context Compra inv CantidadValida: self.cantidad >= 1 and self.cantidad <= 10000",
    "context Compra inv PlazoValido: self.plazo >= 1 and self.plazo <= 180",
    "context Compra inv CotizacionesValidas: self.cotizaciones >= 0 and self.cotizaciones <= 30",
    "context Compra inv ReferenciaValida: self.referencia.size() >= 4",
    "context Compra::avalar() pre JustificacionSuficiente: self.justificacion.size() >= 20",
    "context Compra::certificar() pre PartidaIdentificada: self.partida.size() >= 4",
    "context Compra::directa() pre MontoCompraDirecta: self.monto < 10000 and self.cotizaciones >= 1",
    "context Compra::competitiva() pre UmbralCompetitivo: self.monto >= 10000 and self.cotizaciones >= 3",
    "context Compra::adjudicar() pre CotizacionesComite: self.cotizaciones >= 3",
    "context Compra::emitir() pre ProveedorIdentificado: self.proveedor.size() >= 3",
    "context Compra::contabilizar() pre ReferenciaContable: self.referencia.size() >= 6"
  ]
}
