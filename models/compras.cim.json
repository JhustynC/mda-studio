      "id": "solicitante",
      "nombre": "Solicitante"
    },
    {
      "id": "jefatura",
      "nombre": "Jefatura"
    },
    {
      "id": "presupuesto",
      "nombre": "Presupuesto"
    },
    {
      "id": "compras",
