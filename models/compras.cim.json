{
  "version": 1,
  "id": "compras-institucionales",
  "nombre": "Compras institucionales",
  "objetivo": "Tramitar compras universitarias desde la solicitud y el control presupuestario hasta la recepción, el pago y el cierre.",
  "entidad": "Compra",
  "actores": [
